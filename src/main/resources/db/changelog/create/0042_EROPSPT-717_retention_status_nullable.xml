<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="connor.whitworth@softwire.com" id="0042_EROPSPT-717_retention_status_nullable" context="ddl">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="NO">
                    SELECT IS_NULLABLE
            FROM information_schema.columns
            WHERE TABLE_SCHEMA = DATABASE()
            AND TABLE_NAME = 'postal_vote_application'
            AND COLUMN_NAME = 'retention_status';
            </sqlCheck>
        </preConditions>

        <dropNotNullConstraint tableName="postal_vote_application" columnName="retention_status" />

        <rollback>
            <addNotNullConstraint tableName="postal_vote_application" columnName="retention_status" columnDataType="varchar(20)" />
        </rollback>
    </changeSet>

    <changeSet author="connor.whitworth@softwire.com" id="0042_EROPSPT-717_proxy_retention_status_nullable" context="ddl">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="NO">
                SELECT IS_NULLABLE
                FROM information_schema.columns
                WHERE TABLE_SCHEMA = DATABASE()
                  AND TABLE_NAME = 'proxy_vote_application'
                  AND COLUMN_NAME = 'retention_status';
            </sqlCheck>
        </preConditions>

        <dropNotNullConstraint tableName="proxy_vote_application" columnName="retention_status" />

        <rollback>
            <addNotNullConstraint tableName="proxy_vote_application" columnName="retention_status" columnDataType="varchar(20)"/>
        </rollback>
    </changeSet>
</databaseChangeLog>