<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="connor.whitworth@softwire.com" id="0042_EROPSPT-302_add_postal_vote_application_status_gss_code_date_updated_idx">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="postal_vote_application" indexName="postal_vote_application_status_gss_code_date_updated_idx" />
            </not>
        </preConditions>

        <createIndex tableName="postal_vote_application" indexName="postal_vote_application_status_gss_code_date_updated_idx">
            <column name="status" />
            <column name="gss_code" />
            <column name="date_updated" />
        </createIndex>

        <rollback>
            <dropIndex tableName="postal_vote_application" indexName="postal_vote_application_status_gss_code_date_updated_idx" />
        </rollback>
    </changeSet>

    <changeSet author="connor.whitworth@softwire.com" id="0042_EROPSPT-302_add_proxy_vote_application_status_gss_code_date_updated_idx">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="proxy_vote_application" indexName="proxy_vote_application_status_gss_code_date_updated_idx" />
            </not>
        </preConditions>

        <createIndex tableName="proxy_vote_application" indexName="proxy_vote_application_status_gss_code_date_updated_idx">
            <column name="status" />
            <column name="gss_code" />
            <column name="date_updated" />
        </createIndex>

        <rollback>
            <dropIndex tableName="proxy_vote_application" indexName="proxy_vote_application_status_gss_code_date_updated_idx" />
        </rollback>
    </changeSet>
</databaseChangeLog>
